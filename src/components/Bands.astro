---
import { CATEGORIES, categoryIndex } from '../data/categories';
import { url } from '../lib/url';

interface Props {
  active: string;
  /** 'wall' links to each category wall, 'archive' keeps you in the archive. */
  target?: 'wall' | 'archive';
}
const { active, target = 'wall' } = Astro.props;
const activeIndex = categoryIndex(active);
---

{/*
  Real links, not divs: the bands work with the keyboard, they are announced,
  and they still navigate with JavaScript off. On the wall and the archive a
  click is intercepted so the category can change in place, a page load would
  throw away the colour sweep.
*/}
<nav class="bands" data-bands data-active={activeIndex} aria-label="Categories">
  {
    CATEGORIES.map((c, i) => (
      <a
        class="band"
        data-band={i}
        data-cat={c.id}
        href={url(target === 'archive' ? `${c.id}/all` : c.id)}
        style={`--band-bg:${c.band};--band-ink:${c.ink}`}
        aria-current={i === activeIndex ? 'page' : undefined}
      >
        <span class="band-label">{c.name}</span>
      </a>
    ))
  }
</nav>

<style>
  .bands {
    position: fixed;
    right: 0;
    top: 0;
    bottom: 0;
    z-index: 4;
    display: flex;
    align-items: stretch;
    /* The active band's label grows its font-size for 950ms. Containment keeps
       that relayout inside the bar instead of walking the whole page. */
    contain: layout paint;
  }

  .band {
    position: relative;
    box-sizing: border-box;
    height: 100%;
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    cursor: pointer;
    background: var(--band-bg);
    width: 26px;
    box-shadow: inset 1px 0 0 rgba(255, 255, 255, 0);
    transition:
      width var(--sweep) var(--ease),
      box-shadow 600ms ease;
  }

  /* The inactive lightening. It was an inset shadow, which repaints the band on
     every frame of the 600ms fade; as an overlay it is an opacity change, which
     the compositor does on its own thread. Never `filter` either way, that
     rasterises the layer and blurs the 11px label. */
  .band::before {
    content: '';
    position: absolute;
    inset: 0;
    background: #fff;
    opacity: 0.22;
    transition: opacity 600ms ease;
  }

  .band[aria-current='page'] {
    width: 124px;
    box-shadow: inset 1px 0 0 rgba(255, 255, 255, 0.35);
  }

  .band[aria-current='page']::before {
    opacity: 0;
  }

  .band-label {
    position: relative;
    writing-mode: vertical-rl;
    white-space: nowrap;
    color: var(--band-ink);
    font-family: var(--mono);
    font-weight: 500;
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 3px;
    /* The label morphs, there is no second element to cross-fade. */
    transition:
      font-size 950ms var(--ease),
      letter-spacing 950ms var(--ease);
  }

  .band[aria-current='page'] .band-label {
    font-size: min(4vh, 38px);
    letter-spacing: 0.02em;
  }

  .band:focus-visible {
    outline-offset: -3px;
    outline-color: var(--band-ink);
  }

  /* Phones: the stack turns ninety degrees and sits along the bottom edge,
     where a thumb reaches. The active tab widens to carry its own name and the
     other six share what is left, the same morph as the desktop stack, turned
     on its side. No rule above the bar: the colour is the edge. */
  @media (max-width: 720px) {
    .bands {
      right: 0;
      left: 0;
      top: auto;
      bottom: 0;
      height: calc(var(--band-bar) + env(safe-area-inset-bottom, 0px));
      align-items: flex-end;
      padding-bottom: env(safe-area-inset-bottom, 0px);
    }

    .band {
      flex: 1 1 0;
      width: auto;
      height: 56px;
      transition:
        flex-grow var(--sweep) var(--ease),
        flex-basis var(--sweep) var(--ease),
        height var(--sweep) var(--ease),
        box-shadow 600ms ease;
    }

    .band[aria-current='page'] {
      flex: 0 0 auto;
      width: auto;
      min-width: 88px;
      height: var(--band-bar);
      padding: 0 12px;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.4);
    }

    /* The name is the tab, so it lies along it rather than down it. */
    .band-label {
      writing-mode: horizontal-tb;
      font-size: 0;
      letter-spacing: 0;
      transition:
        font-size var(--sweep) var(--ease),
        letter-spacing var(--sweep) var(--ease);
    }

    .band[aria-current='page'] .band-label {
      font-size: 12px;
      letter-spacing: 0.12em;
    }
  }

  /* The smallest phones: every millimetre the active tab gives back is width
     the other six need to stay hittable. */
  @media (max-width: 360px) {
    .band[aria-current='page'] {
      min-width: 78px;
      padding: 0 9px;
    }
    .band[aria-current='page'] .band-label {
      font-size: 11px;
      letter-spacing: 0.08em;
    }
  }
</style>
