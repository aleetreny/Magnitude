---
import { Font } from 'astro:assets';
import Bands from '../components/Bands.astro';
import { getCategory } from '../data/categories';
import { url } from '../lib/url';
import '../styles/magnitude.css';

interface Props {
  title: string;
  description: string;
  category: string;
  /** 'wall' never scrolls; 'archive' does. */
  variant: 'wall' | 'archive';
}
const { title, description, category, variant } = Astro.props;
const c = getCategory(category);
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-variant={variant}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content={c.bg} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <Font cssVariable="--font-mono" preload />
  </head>

  <body>
    <div class="shell" data-shell style={`background-color:${c.bg};color:${c.ink}`}>
      {/* The colour sweep: a disc of the incoming colour, then a ring of its ink. */}
      <div class="sweep" data-sweep aria-hidden="true"></div>
      <div class="sweep-ring" data-sweep-ring aria-hidden="true"></div>

      <slot />

      <Bands active={category} target={variant === 'archive' ? 'archive' : 'wall'} />
    </div>
  </body>
</html>

<style>
  html[data-variant='wall'],
  html[data-variant='wall'] body {
    height: 100%;
    overflow: hidden;
  }

  .shell {
    font-family: var(--display);
    /* Only the background cross-fades here. `color` is inherited, so animating
       it on the shell re-resolves the computed style of every node in the
       document on every frame of the fade — 589ms of style recalculation per
       category change, measured. The ink now fades on the handful of elements
       that stay visible instead (see `.ink-fade` in magnitude.css); everything
       else is either replayed from zero or sitting under the opaque sweep while
       it changes. */
    transition: background-color var(--sweep) var(--ease);
  }

  html[data-variant='wall'] .shell {
    position: fixed;
    inset: 0;
    display: flex;
    flex-direction: column;
    touch-action: none;
    user-select: none;
    cursor: grab;
  }

  html[data-variant='wall'] .shell:active {
    cursor: grabbing;
  }

  html[data-variant='archive'] .shell {
    min-height: 100vh;
    padding: 0 var(--gutter) 0 var(--edge);
  }

  .sweep,
  .sweep-ring {
    position: fixed;
    border-radius: 50%;
    pointer-events: none;
    z-index: 2;
    opacity: 0;
    left: 100%;
    top: 50%;
    /* Empty, fixed and sized: nothing inside can affect anything outside. */
    contain: strict;
  }

  /* The disc is a flat fill, so it is rastered small and blown up by the
     compositor rather than rastered at its final 230vmax. Same geometry —
     20vmax × 11.5 — for 1/132nd of the pixels: 169² instead of 1941² on a
     phone. A flat colour loses nothing to the upscale, and the circle's edge
     only gets softer. */
  .sweep {
    width: 20vmax;
    height: 20vmax;
  }

  /* The ring cannot take the same trick — its 2px border would scale with it —
     but it is transparent almost everywhere, which is the cheap kind of layer. */
  .sweep-ring {
    width: 230vmax;
    height: 230vmax;
    border: 2px solid transparent;
  }

  .sweep.run {
    animation: sweep 1100ms var(--ease) backwards;
  }
  .sweep-ring.run {
    animation: sweep-ring 1250ms var(--ease) 60ms backwards;
  }

  @keyframes sweep {
    0% {
      transform: translate(-50%, -50%) scale(0);
      opacity: 1;
    }
    62% {
      opacity: 1;
    }
    100% {
      transform: translate(-50%, -50%) scale(11.5);
      opacity: 0;
    }
  }

  @keyframes sweep-ring {
    0% {
      transform: translate(-50%, -50%) scale(0);
      opacity: 0.55;
    }
    100% {
      transform: translate(-50%, -50%) scale(1);
      opacity: 0;
    }
  }

  /* Phones keep the wall's central rule: it never scrolls. The shell reserves
     the band bar's height, so no question can ever pass under it — the wall
     simply shows as many questions as the screen has room for. */
  @media (max-width: 720px) {
    html[data-variant='wall'] .shell {
      padding-bottom: calc(var(--band-bar) + env(safe-area-inset-bottom, 0px));
      /* Sideways belongs to the switcher; there is nothing to scroll. */
      touch-action: none;
      user-select: auto;
      cursor: auto;
    }
  }
</style>
