---
interface Props {
  value: string;
  note: string;
}
const { value, note } = Astro.props;
---

<aside class="key">
  <p class="value mono">{value}</p>
  <p class="note">{note}</p>
</aside>

<style>
  /* No card, no radius, no shadow: two hairlines and the faintest wash. */
  .key {
    margin: 3em 0;
    padding: 26px 24px;
    background: var(--accent-wash);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .value {
    margin: 0;
    font-size: 44px;
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: none;
    color: var(--accent);
  }

  .note {
    margin: 14px 0 0;
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-soft);
    max-width: 42ch;
  }

  @media (max-width: 720px) {
    .key {
      padding: 20px 18px;
    }
    .value {
      font-size: 34px;
    }
  }
</style>
