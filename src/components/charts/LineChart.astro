---
import { scaleLinear } from 'd3-scale';
import { area as d3area, line as d3line } from 'd3-shape';
import { SERIES, formatValue, type FormatOptions } from '../../lib/chart';

export interface Point {
  x: number;
  y: number;
}
export interface Series {
  name: string;
  points: Point[];
}
export interface Tick {
  value: number;
  label: string;
}

interface Props extends FormatOptions {
  series: Series[];
  xTicks: Tick[];
  yTicks: Tick[];
  xDomain?: [number, number];
  yDomain?: [number, number];
  /** Plot height in CSS pixels, the SVG carries geometry only. */
  height?: number;
  /**
   * A 10% wash under a single series. Ignored unless the y-axis starts at or
   * below zero: a filled area on a truncated axis reads as magnitude-from-zero
   * and overstates whatever it is showing.
   */
  area?: boolean;
  caption?: string;
  /** Column heading for x in the table view. */
  xLabel?: string;
}

const {
  series,
  xTicks,
  yTicks,
  xDomain,
  yDomain,
  height = 280,
  area = false,
  caption,
  xLabel = 'x',
  decimals = 0,
  prefix = '',
  suffix = '',
} = Astro.props;

const all = series.flatMap((s) => s.points);
const xs = all.map((p) => p.x);
const ys = all.map((p) => p.y);

/**
 * The SVG holds nothing but geometry, in a normalised 0–100 box stretched to
 * fill the plot area. Every pixel dimension, margins, type, dots, lives in
 * CSS, so the chart reflows without the text shrinking with it.
 */
const x = scaleLinear()
  .domain(xDomain ?? [Math.min(...xs), Math.max(...xs)])
  .range([0, 100]);
const y = scaleLinear()
  .domain(yDomain ?? [Math.min(...ys), Math.max(...ys)])
  .nice()
  .range([100, 0]);

const path = d3line<Point>()
  .x((p) => x(p.x))
  .y((p) => y(p.y));
const wash = d3area<Point>()
  .x((p) => x(p.x))
  .y0(100)
  .y1((p) => y(p.y));

const zeroBased = y.domain()[0]! <= 0;
const showWash = area && series.length === 1 && zeroBased;

const plotted = series.map((s, i) => {
  const last = s.points[s.points.length - 1]!;
  const top = y(last.y);
  return {
    name: s.name,
    colour: SERIES[i] ?? SERIES[0],
    d: path(s.points) ?? '',
    fill: showWash ? (wash(s.points) ?? '') : '',
    end: {
      left: x(last.x),
      /** The dot stays on the datum, whatever the label has to do. */
      top,
      labelTop: top,
      display: formatValue(last.y, { decimals, prefix, suffix }),
    },
  };
});

/**
 * Series that finish within a whisker of one another stack their end labels on
 * top of each other and none of them can be read. The dots stay on their data;
 * the labels are pushed apart by the least that clears them, in reading order,
 * and the whole stack slides back inside the plot if it ran off the bottom.
 */
const MIN_GAP = (13 / height) * 100;
const stack = [...plotted].sort((a, b) => a.end.labelTop - b.end.labelTop);
for (let i = 1; i < stack.length; i++) {
  const above = stack[i - 1]!.end.labelTop;
  if (stack[i]!.end.labelTop - above < MIN_GAP) stack[i]!.end.labelTop = above + MIN_GAP;
}
const spill = (stack[stack.length - 1]?.end.labelTop ?? 0) - 100;
if (spill > 0) for (const s of stack) s.end.labelTop -= spill;

const showLegend = series.length > 1;
const label = series.map((s) => s.name).join(' and ');
---

<figure class="chart">
  {caption && <p class="what">{caption}</p>}

  {
    showLegend && (
      <ul class="legend">
        {plotted.map((s) => (
          <li>
            <span class="key" style={`background:${s.colour}`} aria-hidden="true" />
            {s.name}
          </li>
        ))}
      </ul>
    )
  }

  <div class="plot" style={`--h:${height}px`}>
    <div class="frame">
      <svg
        viewBox="0 0 100 100"
        preserveAspectRatio="none"
        role="img"
        aria-label={`Line chart: ${label}`}
      >
        <g class="grid" shape-rendering="crispEdges">
          {
            yTicks.map((t) => (
              <line
                x1="0"
                x2="100"
                y1={y(t.value)}
                y2={y(t.value)}
                vector-effect="non-scaling-stroke"
              />
            ))
          }
        </g>
        {
          plotted.map(
            (s) => s.fill && <path d={s.fill} fill={s.colour} fill-opacity="0.1" stroke="none" />,
          )
        }
        {
          plotted.map((s) => (
            <path
              d={s.d}
              fill="none"
              stroke={s.colour}
              stroke-width="2"
              stroke-linejoin="round"
              stroke-linecap="round"
              vector-effect="non-scaling-stroke"
            />
          ))
        }
      </svg>
    </div>

    <div class="overlay" aria-hidden="true">
      {
        yTicks.map((t) => (
          <span class="ytick mono" style={`top:${y(t.value)}%`}>
            {t.label}
          </span>
        ))
      }
      {
        xTicks.map((t) => (
          <span class="xtick mono" style={`left:${x(t.value)}%`}>
            {t.label}
          </span>
        ))
      }
      {
        plotted.map((s) => (
          <span class="dot" style={`left:${s.end.left}%;top:${s.end.top}%;background:${s.colour}`} />
        ))
      }
      {
        plotted.map((s) => (
          <span class="end mono" style={`left:${s.end.left}%;top:${s.end.labelTop}%`}>
            {s.end.display}
          </span>
        ))
      }
    </div>
  </div>

  <details class="numbers">
    <summary class="mono">Show the numbers</summary>
    <table>
      <thead>
        <tr>
          <th>{xLabel}</th>
          {series.map((s) => <th>{s.name}</th>)}
        </tr>
      </thead>
      <tbody>
        {
          (series[0]?.points ?? []).map((p, row) => (
            <tr>
              <td>{xTicks.find((t) => t.value === p.x)?.label ?? p.x}</td>
              {series.map((s) => (
                <td>{formatValue(s.points[row]?.y ?? 0, { decimals, prefix, suffix })}</td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </details>
</figure>

<style>
  .chart {
    margin: 0;
  }

  .what {
    margin: 0 0 14px;
    font-size: 14px;
    line-height: 1.45;
    color: var(--ink-soft);
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    margin: 0 0 18px;
    padding: 0;
    list-style: none;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .legend li {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .key {
    width: 14px;
    height: 2px;
    border-radius: 1px;
  }

  .plot {
    position: relative;
    height: var(--h);
    /* Room for the axis type and the end labels, in real pixels. */
    --ml: 44px;
    --mr: 78px;
    --mt: 12px;
    --mb: 28px;
  }

  /* The frame is what the margins size; the SVG then fills it. An SVG is a
     replaced element, so left/right/top/bottom insets alone would leave it at
     its intrinsic 300×150 and spill the paths across the page. */
  .frame,
  .overlay {
    position: absolute;
    left: var(--ml);
    right: var(--mr);
    top: var(--mt);
    bottom: var(--mb);
  }

  .frame svg {
    display: block;
    width: 100%;
    height: 100%;
    /* Let a 2px stroke sit on the top or bottom edge without being halved. */
    overflow: visible;
  }

  .grid line {
    stroke: var(--rule);
    stroke-width: 1;
  }

  .overlay {
    pointer-events: none;
  }

  .ytick,
  .xtick,
  .end {
    position: absolute;
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: none;
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .ytick {
    left: 0;
    transform: translate(calc(-100% - 10px), -50%);
  }

  .xtick {
    top: 100%;
    transform: translate(-50%, 9px);
  }

  .dot {
    position: absolute;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    /* The 2px surface ring keeps the marker legible over the line. */
    box-shadow: 0 0 0 2px var(--paper);
  }

  .end {
    left: 0;
    transform: translate(14px, -50%);
    color: var(--ink);
  }

  .numbers {
    margin-top: 26px;
  }

  .numbers summary {
    font-size: 10px;
    color: var(--ink-soft);
    cursor: pointer;
    list-style: none;
  }

  .numbers summary::-webkit-details-marker {
    display: none;
  }

  .numbers summary::before {
    content: '+ ';
  }

  .numbers[open] summary::before {
    content: '– ';
  }

  .numbers table {
    width: 100%;
    margin-top: 14px;
    border-collapse: collapse;
    font-size: 13px;
  }

  .numbers th {
    font-family: var(--mono);
    font-weight: 500;
    font-size: 9.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-align: left;
    color: var(--ink-soft);
    padding: 6px 10px 6px 0;
    border-bottom: 1px solid var(--rule);
  }

  .numbers td {
    padding: 5px 10px 5px 0;
    border-bottom: 1px solid var(--rule);
    font-variant-numeric: tabular-nums;
  }

  /* No room for end labels on a phone, the legend carries identity there. */
  @media (max-width: 720px) {
    .plot {
      --ml: 36px;
      --mr: 10px;
    }
    .end {
      display: none;
    }
  }
</style>
