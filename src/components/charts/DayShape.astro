---
/**
 * The shape of the day, one line per full year of the tariff.
 *
 * Each hour is drawn against its own year's average rather than in euros: 2022
 * cost more than twice what 2024 did, and plotting the levels would separate
 * the years by the one thing this figure is not about. At 1.0 an hour costs
 * what that year cost on average, so four years of very different prices can be
 * read as four shapes.
 */
import LineChart from './LineChart.astro';
import { POWER } from '../../lib/power-prices';

interface Props {
  caption?: string;
}
const { caption } = Astro.props;

const series = POWER.years.map((y) => ({
  name: String(y.year),
  points: y.shape.map((v, hour) => ({ x: hour, y: v })),
}));

const values = series.flatMap((s) => s.points.map((p) => p.y));
const yLo = Math.floor(Math.min(...values) * 10) / 10;
const yHi = Math.ceil(Math.max(...values) * 10) / 10;

const yTicks: { value: number; label: string }[] = [];
for (let v = Math.ceil(yLo / 0.2) * 0.2; v <= yHi + 1e-9; v += 0.2) {
  const value = +v.toFixed(1);
  yTicks.push({ value, label: value.toFixed(1) });
}

/** Six-hour marks: the same quarters the clock dials are ticked at. */
const xTicks = [0, 6, 12, 18, 23].map((h) => ({
  value: h,
  label: h === 0 ? 'midnight' : h === 12 ? 'noon' : h === 23 ? '11pm' : h < 12 ? `${h}am` : `${h - 12}pm`,
}));
---

<LineChart
  series={series}
  xTicks={xTicks}
  yTicks={yTicks}
  yDomain={[yLo, yHi]}
  xLabel="Hour"
  caption={caption}
  decimals={2}
  suffix="×"
  height={320}
/>
