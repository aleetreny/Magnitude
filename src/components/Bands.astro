---
import { CATEGORIES, categoryIndex } from '../data/categories';
import { url } from '../lib/url';

interface Props {
  active: string;
  /** 'wall' links to each category wall, 'archive' keeps you in the archive. */
  target?: 'wall' | 'archive';
}
const { active, target = 'wall' } = Astro.props;
const activeIndex = categoryIndex(active);
---

{/*
  Real links, not divs: the bands work with the keyboard, they are announced,
  and they still navigate with JavaScript off. On the wall and the archive a
  click is intercepted so the category can change in place — a page load would
  throw away the colour sweep.
*/}
<nav class="bands" data-bands data-active={activeIndex} aria-label="Categories">
  {
    CATEGORIES.map((c, i) => (
      <a
        class="band"
        data-band={i}
        data-cat={c.id}
        href={url(target === 'archive' ? `${c.id}/all` : c.id)}
        style={`--band-bg:${c.band};--band-ink:${c.ink}`}
        aria-current={i === activeIndex ? 'page' : undefined}
      >
        <span class="band-label">{c.name}</span>
      </a>
    ))
  }
</nav>

<style>
  .bands {
    position: fixed;
    right: 0;
    top: 0;
    bottom: 0;
    z-index: 4;
    display: flex;
    align-items: stretch;
  }

  .band {
    position: relative;
    box-sizing: border-box;
    height: 100%;
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    cursor: pointer;
    background: var(--band-bg);
    width: 26px;
    /* Lighten with an inset shadow, never `filter` — a filter rasterises the
       layer and blurs the 11px label. */
    box-shadow: inset 0 0 0 100vh rgba(255, 255, 255, 0.22);
    transition:
      width var(--sweep) var(--ease),
      box-shadow 600ms ease;
  }

  .band[aria-current='page'] {
    width: 124px;
    box-shadow: inset 1px 0 0 rgba(255, 255, 255, 0.35);
  }

  .band-label {
    writing-mode: vertical-rl;
    white-space: nowrap;
    color: var(--band-ink);
    font-family: var(--mono);
    font-weight: 500;
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 3px;
    /* The label morphs — there is no second element to cross-fade. */
    transition:
      font-size 950ms var(--ease),
      letter-spacing 950ms var(--ease);
  }

  .band[aria-current='page'] .band-label {
    font-size: min(4vh, 38px);
    letter-spacing: 0.02em;
  }

  .band:focus-visible {
    outline-offset: -3px;
    outline-color: var(--band-ink);
  }

  /* Phones: the stack turns ninety degrees and sits along the bottom edge,
     where a thumb actually reaches. Seven equal keys across the width give a
     56×58px target each — the sliver version was 8px wide and unhittable. The
     active one rises above the rest; the names live in the accessibility tree
     and, full size, in the footer directly above the bar. */
  @media (max-width: 720px) {
    .bands {
      right: 0;
      left: 0;
      top: auto;
      bottom: 0;
      height: calc(var(--band-bar) + env(safe-area-inset-bottom, 0px));
      align-items: flex-end;
      padding-bottom: env(safe-area-inset-bottom, 0px);
      box-shadow: 0 -1px 0 rgba(22, 24, 26, 0.06);
    }

    .band {
      flex: 1 1 0;
      width: auto;
      height: 58px;
      transition:
        height var(--sweep) var(--ease),
        box-shadow 600ms ease;
    }

    .band[aria-current='page'] {
      width: auto;
      height: var(--band-bar);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.4);
    }

    .band-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
