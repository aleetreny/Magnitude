---
import Shell from '../layouts/Shell.astro';
import Wall from '../components/Wall.astro';
import { CATEGORIES, getCategory } from '../data/categories';
import { publishedPosts } from '../lib/questions';

// Home opens wherever the newest answered question is, so the first thing a
// visitor sees is a wall with something to click. Falls back to the first
// category while nothing is published.
const newest = (await publishedPosts())[0];
const first = newest ? getCategory(newest.data.category) : CATEGORIES[0]!;
---

<Shell
  variant="wall"
  category={first.id}
  title="MAGNITUDE"
  description="A question-led data publication. Every post is a question answered with one or two charts."
>
  <Wall active={first.id} />
</Shell>
