---
interface Props {
  /** Figure number, 1-based. */
  n: number;
  /** What the chart shows, the second half of the FIG. line. */
  title: string;
  /** Dataset id or source line, set below the chart. */
  source: string;
  /** Break out past the measure on large screens. For a chart that needs room. */
  wide?: boolean;
}
const { n, title, source, wide = false } = Astro.props;
---

<figure class:list={['fig', wide && 'fig-wide']}>
  <p class="cap mono">Fig. {n} · {title}</p>
  <div class="plot"><slot /></div>
  <figcaption class="src mono">{source}</figcaption>
</figure>

<style>
  .fig {
    margin: 3.4em 0;
  }

  /* Wide screens: the figure bleeds left into the margin rail. */
  @media (min-width: 1200px) {
    .fig {
      margin-left: -80px;
    }
  }

  /* A wide figure leaves the measure behind entirely and centres itself on the
     viewport. The prose stays at its reading width either side of it. */
  @media (min-width: 1040px) {
    .fig-wide {
      width: min(1120px, 100vw - 96px);
      margin-left: calc(50% - min(1120px, 100vw - 96px) / 2);
      margin-right: 0;
    }
  }

  .cap {
    margin: 0 0 22px;
    padding-top: 12px;
    border-top: 1px solid var(--rule);
    /* The category colour, in type and a hairline. Nowhere else. */
    color: var(--accent);
    font-weight: 500;
    letter-spacing: 0.14em;
  }

  .plot {
    /* Wide content, narrow viewport: scroll the figure, never the page. */
    overflow-x: auto;
  }

  .src {
    margin: 20px 0 0;
    color: var(--ink-soft);
    letter-spacing: 0.1em;
    line-height: 1.5;
  }
</style>
