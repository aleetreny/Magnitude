---
/**
 * The doorways of Europe.
 *
 * One row per country on a single axis of age. A door stands where the survey
 * puts that country in its latest year; behind it, one hairline for each of the
 * four years before, faintest first. Two marks, and the second is the same
 * quantity as the first, one year at a time, so there is nothing to learn
 * before the chart can be read.
 *
 * Everything drawn comes from the survey running now. Eurostat flags a break in
 * series in 2021, the EU-LFS was redefined, and a figure from either side of
 * it is not the same measurement, so the older survey is not in this figure at
 * all. It has its own, where it is drawn on its own axis.
 *
 * A door is a mark, not a picture: only its position along the axis carries a
 * number. Its size is fixed pixels, so nothing about a door's own shape can be
 * read as a quantity.
 *
 * Geometry comes from a D3 scale at build time. Horizontal positions are
 * percentages of the plot and every vertical dimension is CSS pixels, so the
 * chart reflows on a phone instead of scrolling, and the type never shrinks
 * with it. The door itself is one SVG symbol, drawn once and placed 28 times.
 */
import { scaleLinear } from 'd3-scale';
import { SERIES } from '../../lib/chart';
import { LEAVING_HOME, europeanBand } from '../../lib/leaving-home';

interface Props {
  /** The country the article is written from. Drawn heavier, never recoloured. */
  highlight?: string;
}

const { highlight = 'ES' } = Astro.props;
const { countries, meta, summary } = LEAVING_HOME;

/** Only the survey running now. The older one is a different measurement. */
const era = (c: (typeof countries)[number]) => c.series.filter((p) => p.year >= meta.breakYear);

const values = countries.flatMap((c) => era(c).map((p) => p.value));
const lo = Math.min(...values) - 0.6;
const hi = Math.max(...values) + 0.7;

const x = scaleLinear().domain([lo, hi]).range([0, 100]);
const at = (v: number) => `${x(v).toFixed(3)}%`;
const wide = (a: number, b: number) => `${(x(b) - x(a)).toFixed(3)}%`;

const ticks: number[] = [];
for (let t = Math.ceil(lo / 2) * 2; t <= hi; t += 2) ticks.push(t);

const rows = countries.map((c) => {
  const readings = era(c);
  const now = readings[readings.length - 1]!;
  const before = readings.slice(0, -1);
  const reach = {
    min: Math.min(...readings.map((p) => p.value)),
    max: Math.max(...readings.map((p) => p.value)),
  };
  return {
    label: c.label,
    /**
     * Everything this country has done since the survey began: the line the
     * gauge above the rows exists to be measured against. It also gathers the
     * row into one object, without it a far-off early reading reads as a
     * stray mark rather than as where this country came from.
     */
    travel: { left: at(reach.min), width: wide(reach.min, reach.max) },
    /** Faintest for the oldest year, so the trail reads in time order. */
    trail: before.map((p, i) => ({
      left: at(p.value),
      ink: (0.2 + (i / Math.max(1, before.length - 1)) * 0.3).toFixed(2),
      year: p.year,
    })),
    door: at(now.value),
    value: now.value.toFixed(1),
    here: c.code === highlight,
    reading: `${c.label}: ${now.value.toFixed(1)} in ${now.year}; ${before
      .map((p) => `${p.value.toFixed(1)} in ${p.year}`)
      .join(', ')}`,
  };
});

/** The band the European average has never left, in either survey. */
const euro = europeanBand();
const euroStrip = { left: at(euro.min), width: wide(euro.min, euro.max) };

/**
 * A dimension line as long as the median country's whole travel, parked in the
 * empty ground above the rows. It is a length, not a position: the chart exists
 * to be read against how far apart the doors sit.
 */
const gauge = { width: wide(lo, lo + summary.medianSpanNow) };

/** Column headings for the table, taken from the whole set rather than a row. */
const span = (which: 'pre' | 'post') =>
  `${Math.min(...countries.map((c) => c[which].from))}–${Math.max(
    ...countries.map((c) => c[which].to),
  )}`;
---

<figure class="doorways" style={`--door:${SERIES[0]}`}>
  <svg width="0" height="0" class="defs" aria-hidden="true" focusable="false">
    <symbol id="mg-door" viewBox="0 0 12 26">
      <!-- The step, a little proud of the frame on each side. -->
      <rect x="0" y="24.7" width="12" height="0.9" fill="var(--door)" fill-opacity="0.45"></rect>
      <!-- The opening the leaf has swung clear of. -->
      <rect x="8" y="1" width="3" height="23.2" fill="#16181a" fill-opacity="0.16"></rect>
      <!-- The leaf, hinged left. -->
      <rect x="1" y="1" width="7" height="23.2" fill="var(--door)"></rect>
      <circle cx="6.8" cy="13" r="0.82" fill="var(--paper)"></circle>
      <!-- Jambs and lintel, drawn last so they close the shape. -->
      <rect
        x="0.55"
        y="0.55"
        width="10.9"
        height="24.1"
        fill="none"
        stroke="#16181a"
        stroke-opacity="0.4"
        stroke-width="0.9"></rect>
    </symbol>
  </svg>

  <!-- The key is the marks themselves, set in the line that names them. -->
  <p class="what">
    <span class="item">
      <svg class="mark-door" viewBox="0 0 12 26" aria-hidden="true"><use href="#mg-door" /></svg>
      the age in {meta.lastYear}
    </span>
    <span class="item"><span class="mark-trail" aria-hidden="true" /> the four years before</span>
  </p>

  <div class="plot">
    <div class="head">
      <span class="euro-note mono" style={`left:${euroStrip.left}`}>
        <b>European average</b>
        {euro.min}–{euro.max}
      </span>
    </div>

    <div class="body">
      <div class="behind" aria-hidden="true">
        {ticks.map((t) => <span class="rule" style={`left:${at(t)}`} />)}
        <span class="euro" style={`left:${euroStrip.left};width:${euroStrip.width}`}></span>
      </div>

      <div class="rows">
        {
          rows.map((r) => (
            <div class:list={['row', r.here && 'here']}>
              <span class="name">{r.label}</span>
              <span class="field" role="img" aria-label={r.reading}>
                <span class="travel" style={`left:${r.travel.left};width:${r.travel.width}`} />
                {r.trail.map((t) => (
                  <span class="tick" style={`left:${t.left};opacity:${t.ink}`} />
                ))}
                <svg class="door" viewBox="0 0 12 26" style={`left:${r.door}`} aria-hidden="true">
                  <use href="#mg-door" />
                </svg>
              </span>
              <span class="value mono">{r.value}</span>
            </div>
          ))
        }
      </div>
    </div>

    <div class="axis">
      {ticks.map((t) => <span class="tick-label mono" style={`left:${at(t)}`}>{t}</span>)}
    </div>

    <!-- A scale bar, where a scale bar goes. Anchored to nothing, so it cannot
         collide with the note above however narrow the plot gets. -->
    <div class="foot">
      <span class="gauge" style={`width:${gauge.width}`} aria-hidden="true"></span>
      <span class="gauge-note mono">
        <b>{summary.medianSpanNow} years</b> · median travel since {meta.breakYear}
      </span>
    </div>
  </div>

  <details class="numbers">
    <summary class="mono">Show the numbers</summary>
    <table>
      <thead>
        <tr>
          <th>Country</th>
          <th>{meta.lastYear}</th>
          <th>{span('post')}</th>
          <th>{span('pre')}</th>
        </tr>
      </thead>
      <tbody>
        {
          countries.map((c) => (
            <tr>
              <td>{c.label}</td>
              <td class="mono num">{c.post.last.toFixed(1)}</td>
              <td class="mono num">
                {c.post.min.toFixed(1)}–{c.post.max.toFixed(1)}
              </td>
              <td class="mono num soft">
                {c.pre.min.toFixed(1)}–{c.pre.max.toFixed(1)}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </details>
</figure>

<style>
  .doorways {
    --name-col: 124px;
    --value-col: 46px;
    --row-h: 30px;
    --door-w: 12px;
    --door-h: 26px;
    margin: 0;
  }

  .defs {
    position: absolute;
  }

  /* ---- The line that names the marks ------------------------------------ */

  .what {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px 30px;
    margin: 0 0 30px;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .mark-door {
    width: var(--door-w);
    height: var(--door-h);
    overflow: visible;
  }

  .item {
    display: inline-flex;
    align-items: center;
    gap: 9px;
  }

  /* The trail as it is actually drawn: three years on their travel line. */
  .mark-trail {
    position: relative;
    width: 30px;
    height: 18px;
  }

  .mark-trail::before {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1px;
    background: rgba(22, 24, 26, 0.22);
  }

  .mark-trail::after {
    content: '';
    position: absolute;
    left: 4px;
    top: 3px;
    height: 13px;
    width: 1px;
    background: var(--ink);
    opacity: 0.32;
    box-shadow:
      9px 0 0 var(--ink),
      19px 0 0 var(--ink);
  }

  /* ---- The chart -------------------------------------------------------- */

  .plot {
    position: relative;
  }

  .head {
    position: relative;
    height: 40px;
    margin-left: var(--name-col);
    margin-right: var(--value-col);
  }

  .euro-note {
    position: absolute;
    bottom: 4px;
    padding-left: 8px;
    border-left: 1px solid var(--rule);
    transform: translateX(-1px);
    font-size: 9.5px;
    letter-spacing: 0.06em;
    line-height: 1.5;
    text-transform: none;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .euro-note b {
    display: block;
    font-weight: 500;
    color: var(--ink);
  }

  /* The scale bar sits on the same frame as the axis, so its length is read
     against the same scale as everything above it. */
  .foot {
    display: flex;
    align-items: center;
    gap: 11px;
    margin: 16px var(--value-col) 0 var(--name-col);
  }

  /* A dimension line, drawn the way one is: a rule closed by two end ticks. */
  .gauge {
    flex: none;
    height: 7px;
    border-bottom: 1px solid rgba(22, 24, 26, 0.45);
    border-left: 1px solid rgba(22, 24, 26, 0.45);
    border-right: 1px solid rgba(22, 24, 26, 0.45);
  }

  .gauge-note {
    font-size: 9.5px;
    letter-spacing: 0.06em;
    line-height: 1.5;
    text-transform: none;
    color: var(--ink-soft);
  }

  .gauge-note b {
    font-weight: 500;
    color: var(--ink);
  }

  .body {
    position: relative;
  }

  .behind {
    position: absolute;
    left: var(--name-col);
    right: var(--value-col);
    top: 0;
    bottom: 0;
    pointer-events: none;
  }

  .rule {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--rule);
    opacity: 0.5;
  }

  .euro {
    position: absolute;
    top: 0;
    bottom: 0;
    background: rgba(22, 24, 26, 0.05);
    border-left: 1px dashed rgba(22, 24, 26, 0.3);
    border-right: 1px dashed rgba(22, 24, 26, 0.3);
  }

  .row {
    display: grid;
    grid-template-columns: var(--name-col) 1fr var(--value-col);
    align-items: center;
    height: var(--row-h);
  }

  .name {
    padding-right: 14px;
    font-size: 13px;
    line-height: 1.2;
    text-align: right;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .field {
    position: relative;
    height: var(--row-h);
  }

  /* The ground each door stands on, and the only rule between rows. */
  .field::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1px;
    height: 1px;
    background: rgba(22, 24, 26, 0.07);
  }

  /* Everything one country has done since 2021, end to end. */
  .travel {
    position: absolute;
    top: calc(var(--row-h) / 2);
    height: 1px;
    min-width: 1px;
    background: rgba(22, 24, 26, 0.22);
  }

  /* One earlier year. Faintest is oldest, so the trail reads in time order. */
  .tick {
    position: absolute;
    top: 8px;
    height: 13px;
    width: 1px;
    background: var(--ink);
  }

  .door {
    position: absolute;
    top: calc((var(--row-h) - var(--door-h)) / 2);
    width: var(--door-w);
    height: var(--door-h);
    /* The datum is the middle of the doorway, not the edge of the leaf. */
    transform: translateX(calc(var(--door-w) / -2));
    overflow: visible;
  }

  .value {
    padding-left: 12px;
    font-size: 10.5px;
    letter-spacing: 0.04em;
    text-transform: none;
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }

  /* The country the piece is written from. Weight and a wash, never a hue:
     the one colour on this chart belongs to the doors. */
  .here {
    background: var(--accent-wash);
  }

  .here .name {
    font-weight: 500;
  }

  .here .value {
    color: var(--ink);
  }

  .axis {
    position: relative;
    height: 26px;
    margin-left: var(--name-col);
    margin-right: var(--value-col);
    border-top: 1px solid var(--rule);
  }

  .tick-label {
    position: absolute;
    top: 7px;
    transform: translateX(-50%);
    font-size: 10px;
    letter-spacing: 0.04em;
    text-transform: none;
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }

  /* ---- The numbers ------------------------------------------------------ */

  .numbers {
    margin-top: 26px;
  }

  .numbers summary {
    font-size: 10px;
    color: var(--ink-soft);
    cursor: pointer;
    list-style: none;
  }

  .numbers summary::-webkit-details-marker {
    display: none;
  }

  .numbers summary::before {
    content: '+ ';
  }

  .numbers[open] summary::before {
    content: '– ';
  }

  /* Five columns will not fit a phone. The table scrolls inside itself so the
     figure above it never has to. */
  .numbers {
    overflow-x: auto;
  }

  .numbers table {
    width: 100%;
    margin-top: 14px;
    border-collapse: collapse;
    font-size: 13px;
  }

  .numbers th {
    font-family: var(--mono);
    font-weight: 500;
    font-size: 9.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-align: left;
    color: var(--ink-soft);
    padding: 6px 10px 6px 0;
    border-bottom: 1px solid var(--rule);
  }

  .numbers td {
    padding: 5px 10px 5px 0;
    border-bottom: 1px solid var(--rule);
  }

  .numbers .num {
    font-size: 11.5px;
    letter-spacing: 0.02em;
    text-transform: none;
    font-variant-numeric: tabular-nums;
  }

  /* The older survey is here for the record, not for comparison. */
  .numbers .soft {
    color: var(--ink-soft);
  }

  @media (max-width: 860px) {
    .doorways {
      --name-col: 92px;
      --value-col: 38px;
    }
    .name {
      font-size: 11.5px;
      padding-right: 10px;
    }
    /* Anchored to a column only 40px from the left edge, the note has nowhere
       to run. Static position makes the inline `left` inert and it falls into
       normal flow above the plot. */
    .euro-note {
      position: static;
      display: block;
      white-space: normal;
      padding: 0;
      border: 0;
      transform: none;
    }
    .head {
      height: auto;
      margin: 0 0 14px;
    }
    .foot {
      align-items: flex-start;
      gap: 8px;
    }
  }
</style>
