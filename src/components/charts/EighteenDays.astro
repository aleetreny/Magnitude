---
/**
 * Eighteen European days, each drawn as the twenty-four hours it is.
 *
 * One row per country, one row exactly a day long, so two rows can be compared
 * without reading a single number: the blocks line up or they do not.
 *
 * Five threads stitch the wall together. Each one runs through the seam between
 * two blocks, country by country, from the top of the wall to the bottom. The
 * seams are where the day is decided, and a thread is the only way to see how
 * little they wander: without it the eye has to carry a position across the gap
 * between rows and guess. With it, the answer to the question is the shape of
 * five lines, and they are very nearly straight.
 *
 * Geometry is a d3 stack over the six blocks and a linear scale across the day,
 * resolved at build time. Horizontal positions are percentages and every
 * vertical dimension is CSS pixels, so the wall reflows onto a phone without
 * the type shrinking with it. The threads live in one SVG laid over the rows,
 * in a box normalised to the row pitch rather than to pixels, which is what
 * lets the same coordinates serve both the desktop rows and the shorter ones a
 * phone gets.
 *
 * Rows are ordered by time at the table, the one block that sorts Europe from
 * the Mediterranean down to the Baltic.
 */
import { scaleLinear } from 'd3-scale';
import { stack } from 'd3-shape';
import { BANDS } from '../../lib/chart';
import { TIME_USE, clock, spoken } from '../../lib/time-use';

const { bands, countries, median, meta, summary } = TIME_USE;

/** Row height and the gap under it, as a ratio. CSS keeps this ratio at 5:1
 *  on both sides of the breakpoint, so one set of coordinates serves both. */
const ROW = 5;
const GAP = 1;
const PITCH = ROW + GAP;
/** The wall in row pitches: the last row carries no trailing gap. */
const WALL = countries.length - GAP / PITCH;

const x = scaleLinear().domain([0, meta.day]).range([0, 100]);

const keys = bands.map((b) => b.key);
const series = stack().keys(keys)(
  countries.map((c) => Object.fromEntries(bands.map((b, i) => [b.key, c.parts[i]!]))) as never,
);

/** Each row, as blocks laid end to end across the day. */
const rows = countries.map((c, i) => ({
  label: c.label,
  edge: i === 0 || i === countries.length - 1,
  blocks: bands.map((b, j) => {
    const [from, to] = series[j]![i] as unknown as [number, number];
    const last = j === bands.length - 1;
    const first = j === 0;
    // A pixel is taken off each side of a block, so the channel between two of
    // them is two pixels wide and the seam runs down the middle of it. Off one
    // side only and the thread would ride the edge of the next block.
    const trimLeft = first ? 0 : 1;
    const trimRight = last ? 0 : 1;
    return {
      key: b.key,
      left: x(from),
      width: x(to) - x(from),
      trimLeft,
      trim: trimLeft + trimRight,
      last,
      /** Null on the residual, which CSS then hatches instead of filling. */
      fill: BANDS[j] ?? null,
      title: `${c.label} · ${b.label} · ${clock(c.parts[j]!)}`,
    };
  }),
}));

/**
 * The five seams, each a thread through the boundary it marks, from the top of
 * the wall to the bottom.
 *
 * A thread runs straight down inside a row, in the channel between the two
 * blocks it separates, and takes its whole sideways step in the gap between one
 * row and the next. Drawn instead from row centre to row centre it would slice
 * diagonally across the fills, which reads as a mistake and exaggerates how far
 * the seam has actually moved.
 */
const threads = keys.slice(0, -1).map((_, j) => {
  const at = countries.flatMap((_, i) => {
    const seam = x(series[j]![i]![1] as number) * 10;
    return [
      { x: seam, y: i },
      { x: seam, y: i + ROW / PITCH },
    ];
  });
  return at.map((p, k) => `${k ? 'L' : 'M'}${p.x.toFixed(2)} ${p.y.toFixed(3)}`).join('');
});

/** Where each block's heading hangs, measured on the median day. */
const medianTotal = median.reduce((a, b) => a + b, 0);
let walked = 0;
const heads = bands.map((b, i) => {
  const at = ((walked + median[i]! / 2) / medianTotal) * 100;
  walked += median[i]!;
  return { label: b.label, at, lower: i % 2 === 1, tail: i === bands.length - 1 };
});

/** The unit is in the figure's title, so the axis carries numbers only. */
const HOURS = [0, 6, 12, 18, 24];

const sleep = summary.sleep;
const widest = summary.widest;
const reading =
  `Eighteen European countries, each drawn as one day of twenty-four hours split into ` +
  `${bands.map((b) => b.label).join(', ')}. The blocks are close to the same size everywhere: ` +
  `every country sleeps between ${spoken(sleep.min)} and ${spoken(sleep.max)}, and no block of ` +
  `the day is more than ${spoken(widest.range)} wider in one country than in another. Rows run ` +
  `from ${countries[0]!.label}, longest at the table, to ${countries[countries.length - 1]!.label}, shortest.`;
---

<figure class="days">
  <div class="plot">
    <div class="head" aria-hidden="true">
      {
        heads.map((h) => (
          <span
            class:list={['tag', 'mono', h.lower && 'lower', h.tail && 'tail']}
            style={h.tail ? undefined : `left:${h.at.toFixed(2)}%`}
          >
            {h.label}
          </span>
        ))
      }
    </div>

    <div class="wall" role="img" aria-label={reading}>
      <div class="rows">
        {
          rows.map((r) => (
            <div class="row">
              <span class:list={['who', r.edge && 'edge']}>{r.label}</span>
              <div class="day">
                {r.blocks.map((b) => (
                  <span
                    class:list={['seg', b.last && 'last']}
                    style={
                      `left:calc(${b.left.toFixed(3)}% + ${b.trimLeft}px);` +
                      // The trim comes off the width, never off the position, so
                      // a block still starts where its hour says it does.
                      `width:calc(${b.width.toFixed(3)}% - ${b.trim}px)` +
                      (b.fill ? `;background:${b.fill}` : '')
                    }
                    data-band={b.key}
                    title={b.title}
                  />
                ))}
              </div>
            </div>
          ))
        }
      </div>

      <div class="threads" aria-hidden="true">
        <svg viewBox={`0 0 1000 ${WALL.toFixed(3)}`} preserveAspectRatio="none" focusable="false">
          {threads.map((d) => <path d={d} />)}
        </svg>
      </div>
    </div>

    <div class="axis" aria-hidden="true">
      {
        HOURS.map((h) => (
          <span class="tick mono" style={`left:${(h / 24) * 100}%`}>
            {h}
          </span>
        ))
      }
    </div>
  </div>
</figure>

<style>
  .days {
    --who: 104px;
    --row: 25px;
    --gap: 5px;
    margin: 0;
  }

  .plot {
    position: relative;
  }

  /* Two lines of headings, so a block only two centimetres wide still gets a
     word of its own instead of an abbreviation. */
  .head {
    position: relative;
    height: 40px;
    margin-left: var(--who);
  }

  .tag {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: none;
    color: var(--ink);
    white-space: nowrap;
  }

  .tag::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 15px;
    width: 1px;
    height: 25px;
    background: var(--rule);
  }

  .tag.lower {
    top: 18px;
  }

  .tag.lower::after {
    height: 7px;
  }

  /* The last block ends at the edge of the wall, so its heading is hung from
     the edge rather than from a centre that would push it off the page. */
  .tag.tail {
    right: 0;
    transform: none;
  }

  .tag.tail::after {
    left: auto;
    right: 8px;
  }

  .wall {
    position: relative;
  }

  .rows {
    display: flex;
    flex-direction: column;
    gap: var(--gap);
  }

  .row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .who {
    flex: none;
    width: calc(var(--who) - 10px);
    text-align: right;
    font-size: 11.5px;
    line-height: 1.2;
    color: var(--ink-soft);
  }

  /* The two ends of the sort carry the sentence under the figure. */
  .who.edge {
    color: var(--ink);
  }

  .day {
    position: relative;
    flex: 1 1 auto;
    height: var(--row);
  }

  .seg {
    position: absolute;
    top: 0;
    bottom: 0;
    border-radius: 1px;
  }

  /* The residual is not a category and is not given a colour of its own: it is
     what the five named blocks leave behind, and it is drawn as such. */
  .seg[data-band='rest'] {
    background-color: #f1efec;
    background-image: repeating-linear-gradient(
      -45deg,
      rgba(22, 24, 26, 0.34) 0 1px,
      transparent 1px 5px
    );
  }

  /* The box covers exactly the strip, never the column of names, and the SVG
     inside it is stretched to fill it. The stroke is held at one pixel rather
     than stretched with the box. */
  .threads {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--who);
    right: 0;
    pointer-events: none;
  }

  .threads svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .threads path {
    fill: none;
    stroke: rgba(22, 24, 26, 0.42);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .axis {
    position: relative;
    height: 22px;
    margin-top: 8px;
    margin-left: var(--who);
    border-top: 1px solid var(--rule);
  }

  .tick {
    position: absolute;
    top: 6px;
    transform: translateX(-50%);
    font-size: 10px;
    letter-spacing: 0.04em;
    text-transform: none;
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .tick:first-child {
    transform: none;
  }

  .tick:last-child {
    left: auto !important;
    right: 0;
    transform: none;
  }

  @media (max-width: 720px) {
    .days {
      --who: 82px;
      --row: 15px;
      --gap: 3px;
    }

    .row {
      gap: 7px;
    }

    .who {
      width: calc(var(--who) - 7px);
      font-size: 9.5px;
    }

    .tag {
      font-size: 9.5px;
    }
  }
</style>
