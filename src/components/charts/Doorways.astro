---
/**
 * The doorways of Europe.
 *
 * One row per country, on a single axis of age. The door is the last reading;
 * behind it lie two bands, one per survey, each as wide as everything that
 * survey ever said about that country. A door is a mark, not a picture: only
 * its position along the axis carries a number.
 *
 * The two bands are drawn in separate lanes on purpose. Eurostat flags a break
 * in series in 2021 — the EU-LFS was redefined — so the older readings and the
 * newer ones are not the same measurement, and the distance between the lanes
 * is not a change in anybody's life. Stacking them would have invited exactly
 * that reading; two lanes and two labels do not.
 *
 * Geometry is computed here with a D3 scale and shipped as inert HTML: every
 * horizontal position is a percentage of the plot, every vertical dimension is
 * CSS pixels, so the chart reflows on a phone without the type shrinking.
 */
import { scaleLinear } from 'd3-scale';
import { SERIES } from '../../lib/chart';
import { LEAVING_HOME, europeanBand, type Era, type Territory } from '../../lib/leaving-home';

interface Props {
  /** Names what is plotted, so the chart needs no legend box. */
  caption?: string;
  /** The country the article is written from. Drawn heavier, never recoloured. */
  highlight?: string;
}

const { caption, highlight = 'ES' } = Astro.props;
const { countries, meta } = LEAVING_HOME;

const values = countries.flatMap((c) => c.series.map((p) => p.value));
const lo = Math.floor(Math.min(...values) - 0.5);
const hi = Math.ceil(Math.max(...values) + 0.5);

const x = scaleLinear().domain([lo, hi]).range([0, 100]);
const at = (v: number) => `${x(v).toFixed(3)}%`;
const wide = (a: number, b: number) => `${(x(b) - x(a)).toFixed(3)}%`;
const band = (era: Era) => ({ left: at(era.min), width: wide(era.min, era.max) });

const ticks: number[] = [];
for (let t = Math.ceil(lo / 2) * 2; t <= hi; t += 2) ticks.push(t);

const rows = countries.map((c) => ({
  code: c.code,
  label: c.label,
  old: band(c.pre),
  /** Where the old survey left the country, its last year before the break. */
  handover: at(c.pre.last),
  now: band(c.post),
  door: at(c.post.last),
  value: c.post.last.toFixed(1),
  here: c.code === highlight,
  reading: `${c.label}: ${c.post.last} in ${c.post.to}, ${c.pre.min} to ${c.pre.max} across ${c.pre.from}–${c.pre.to}`,
}));

/** The band the European average has never left, in either survey. */
const euro = europeanBand();
const euroStrip = { left: at(euro.min), width: wide(euro.min, euro.max) };

/**
 * A dimension line as long as the median country's whole record, parked in the
 * empty ground above the rows. It is a length, not a position — the one thing
 * the chart is for is comparing it against how far apart the doors sit.
 */
const gauge = { width: wide(lo, lo + LEAVING_HOME.summary.medianSpan) };

/**
 * Column headings for the table. Countries enter the record in different
 * years — Croatia in 2002, Ireland in 2006 — so each era is headed by the
 * whole set's range, never by whichever country happens to sort first.
 */
const eraLabel = (which: 'pre' | 'post') =>
  `${Math.min(...countries.map((c) => c[which].from))}–${Math.max(
    ...countries.map((c) => c[which].to),
  )}`;

/**
 * The key magnifies one real row — no invented geometry — on its own axis, so
 * the parts sit far enough apart to be named.
 */
const shown: Territory = countries.find((c) => c.code === highlight) ?? countries[0]!;
const gLo = Math.min(shown.pre.min, shown.post.min) - 0.55;
const gHi = Math.max(shown.pre.max, shown.post.max) + 0.75;
const g = scaleLinear().domain([gLo, gHi]).range([0, 100]);
const gAt = (v: number) => `${g(v).toFixed(3)}%`;
const gWide = (a: number, b: number) => `${(g(b) - g(a)).toFixed(3)}%`;

const gTicks: number[] = [];
for (let t = Math.ceil(gLo); t <= gHi; t += 1) gTicks.push(t);

const key = {
  old: { left: gAt(shown.pre.min), width: gWide(shown.pre.min, shown.pre.max) },
  oldMid: gAt((shown.pre.min + shown.pre.max) / 2),
  handover: gAt(shown.pre.last),
  now: { left: gAt(shown.post.min), width: gWide(shown.post.min, shown.post.max) },
  nowMid: gAt((shown.post.min + shown.post.max) / 2),
  door: gAt(shown.post.last),
};
---

<figure class="doorways" style={`--door:${SERIES[0]}`}>
  {caption && <p class="what">{caption}</p>}

  <!-- ---- How to read one row, on one real country, magnified ------------ -->
  <div class="key">
    <p class="kicker mono">
      How to read a row<span class="only-wide"> · {shown.label}, magnified</span>
    </p>

    <div class="key-plot">
      <div class="key-field">
        <span class="call call-old mono" style={`left:${key.oldMid}`}>
          <b>{shown.pre.from}–{shown.pre.to}</b> every reading of the old survey
        </span>
        <span class="lead lead-old" style={`left:${key.oldMid}`}></span>

        <span class="call call-hand mono" style={`left:${key.handover}`}>
          <b>{shown.pre.to}</b> where the old survey left it
        </span>
        <span class="lead lead-hand" style={`left:${key.handover}`}></span>

        <span class="era old" style={`left:${key.old.left};width:${key.old.width}`}></span>
        <span class="handover" style={`left:${key.handover}`}></span>
        <span class="era new" style={`left:${key.now.left};width:${key.now.width}`}></span>
        <span class="door" style={`left:${key.door}`}></span>

        <span class="lead lead-door" style={`left:${key.door}`}></span>
        <span class="call call-door mono" style={`left:${key.door}`}>
          <b>the door</b> {shown.post.last} in {shown.post.to}
        </span>

        <span class="lead lead-new" style={`left:${key.nowMid}`}></span>
        <span class="call call-new mono" style={`left:${key.nowMid}`}>
          <b>{shown.post.from}–{shown.post.to}</b> the survey after it was redefined
        </span>
      </div>

      <div class="key-axis mono">
        {gTicks.map((t) => <span style={`left:${gAt(t)}`}>{t}</span>)}
      </div>
    </div>

    <!-- The same four parts, named in a line, where there is no room to draw
         the magnified row: under 860px the callouts cannot sit clear of it. -->
    <ul class="legend">
      <li>
        <span class="sw sw-old" aria-hidden="true"></span>
        <span><b>{shown.pre.from}–{shown.pre.to}</b> every reading of the old survey</span>
      </li>
      <li>
        <span class="sw sw-hand" aria-hidden="true"></span>
        <span><b>{shown.pre.to}</b> where the old survey left it</span>
      </li>
      <li>
        <span class="sw sw-new" aria-hidden="true"></span>
        <span><b>{shown.post.from}–{shown.post.to}</b> the survey after it was redefined</span>
      </li>
      <li>
        <span class="sw sw-door" aria-hidden="true"></span>
        <span><b>the door</b> where it stands in {shown.post.to}</span>
      </li>
    </ul>

    <p class="caveat">
      The two lanes are two surveys, not two moments. Eurostat flags a break in
      series in {meta.breakYear} for {meta.breakCount} of the territories it publishes,
      so the step between the lanes measures the change in the definition — not a
      change in when anybody left.
    </p>
  </div>

  <!-- ---- The chart ------------------------------------------------------ -->
  <div class="plot">
    <div class="head">
      <span class="gauge" style={`width:${gauge.width}`} aria-hidden="true"></span>
      <span class="gauge-note mono" style={`left:${gauge.width}`}>
        <b>{LEAVING_HOME.summary.medianSpan} years wide</b>
        the median country's entire record under the old survey
      </span>

      <span class="euro-note mono" style={`left:${euroStrip.left}`}>
        <b>The European average never leaves this column</b>
        {euro.min}–{euro.max}, every year of both surveys
      </span>
    </div>

    <div class="body">
      <div class="behind" aria-hidden="true">
        {ticks.map((t) => <span class="rule" style={`left:${at(t)}`}></span>)}
        <span class="euro" style={`left:${euroStrip.left};width:${euroStrip.width}`}></span>
      </div>

      <div class="rows">
        {
          rows.map((r) => (
            <div class:list={['row', r.here && 'here']}>
              <span class="name">{r.label}</span>
              <span class="field" role="img" aria-label={r.reading}>
                <span class="era old" style={`left:${r.old.left};width:${r.old.width}`} />
                <span class="handover" style={`left:${r.handover}`} />
                <span class="era new" style={`left:${r.now.left};width:${r.now.width}`} />
                <span class="door" style={`left:${r.door}`} />
              </span>
              <span class="value mono">{r.value}</span>
            </div>
          ))
        }
      </div>
    </div>

    <div class="axis">
      {ticks.map((t) => <span class="tick mono" style={`left:${at(t)}`}>{t}</span>)}
    </div>
  </div>

  <details class="numbers">
    <summary class="mono">Show the numbers</summary>
    <table>
      <thead>
        <tr>
          <th>Country</th>
          <th>{eraLabel('pre')}</th>
          <th>{eraLabel('post')}</th>
          <th>{meta.lastYear}</th>
        </tr>
      </thead>
      <tbody>
        {
          countries.map((c) => (
            <tr>
              <td>{c.label}</td>
              <td class="mono num">
                {c.pre.min.toFixed(1)}–{c.pre.max.toFixed(1)}
              </td>
              <td class="mono num">
                {c.post.min.toFixed(1)}–{c.post.max.toFixed(1)}
              </td>
              <td class="mono num">{c.post.last.toFixed(1)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </details>
</figure>

<style>
  .doorways {
    --name-col: 124px;
    --value-col: 46px;
    --row-h: 27px;
    --lane-h: 9px;
    --door-w: 9px;
    margin: 0;
  }

  .what {
    margin: 0 0 22px;
    font-size: 14px;
    line-height: 1.45;
    color: var(--ink-soft);
  }

  /* ---- The key ---------------------------------------------------------- */

  .key {
    margin: 0 0 34px;
    padding: 18px 20px 16px;
    border: 1px solid var(--rule);
  }

  .kicker {
    margin: 0 0 44px;
    font-size: 9.5px;
    letter-spacing: 0.16em;
    color: var(--ink-soft);
  }

  .key-plot {
    position: relative;
  }

  .key-field {
    position: relative;
    height: 44px;
  }

  /* Callouts sit clear of the marks: two above, one below, each on a leader. */
  .call {
    position: absolute;
    font-size: 9.5px;
    letter-spacing: 0.06em;
    line-height: 1.5;
    text-transform: none;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .call b {
    font-weight: 500;
    color: var(--ink);
  }

  .call-old {
    top: -38px;
    transform: translateX(-50%);
  }

  .call-door {
    top: -20px;
    transform: translateX(-8px);
  }

  /* Below the lanes but above the axis: the only clear air left. */
  .call-new {
    top: 50px;
    transform: translateX(-50%);
  }

  /* Anchored to the right of its mark, so it runs back into empty ground. */
  .call-hand {
    top: -20px;
    transform: translateX(-100%);
    padding-right: 8px;
  }

  .lead {
    position: absolute;
    width: 1px;
    background: var(--rule);
  }

  .lead-old {
    top: -22px;
    height: 20px;
  }

  .lead-door {
    top: -6px;
    height: 8px;
    transform: translateX(-0.5px);
  }

  .lead-new {
    top: 40px;
    height: 10px;
  }

  .lead-hand {
    top: -6px;
    height: 10px;
  }

  .key-axis {
    position: relative;
    height: 18px;
    /* Clears the callout that sits under the lanes. */
    margin-top: 44px;
    border-top: 1px solid var(--rule);
  }

  .key-axis span {
    position: absolute;
    top: 5px;
    transform: translateX(-50%);
    font-size: 9.5px;
    letter-spacing: 0.04em;
    text-transform: none;
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }

  .legend {
    display: none;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .legend li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 5px 0;
    font-size: 12px;
    line-height: 1.45;
    color: var(--ink-soft);
  }

  .legend b {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    font-weight: 500;
    color: var(--ink);
  }

  /* The swatches are the marks themselves, at the size they are drawn. */
  /* Each swatch keeps the lane its mark occupies in the chart, so the list
     carries the one thing a list otherwise loses. */
  .sw {
    position: relative;
    flex: none;
    width: 26px;
    height: 21px;
  }

  .sw-old::before,
  .sw-new::before,
  .sw-hand::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 8px;
    background: rgba(22, 24, 26, 0.07);
    border-left: 1px solid rgba(22, 24, 26, 0.28);
    border-right: 1px solid rgba(22, 24, 26, 0.28);
  }

  .sw-old::before,
  .sw-hand::before {
    top: 1px;
  }

  .sw-new::before {
    bottom: 1px;
  }

  .sw-hand::before {
    background: none;
    border-left: none;
    border-right: 1px solid rgba(22, 24, 26, 0.5);
  }

  .sw-door::before {
    content: '';
    position: absolute;
    left: 8.5px;
    top: 0;
    bottom: 2px;
    width: 9px;
    background: var(--door);
  }

  .sw-door::after {
    content: '';
    position: absolute;
    left: 15px;
    top: 8px;
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: var(--paper);
  }

  .caveat {
    margin: 30px 0 0;
    max-width: 62ch;
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--ink-soft);
  }

  /* ---- The marks. Shared by the key and the chart ----------------------- */

  .field,
  .key-field {
    display: block;
  }

  /* Everything one survey ever said about one country. */
  .era {
    position: absolute;
    min-width: 2px;
    background: rgba(22, 24, 26, 0.07);
    border-left: 1px solid rgba(22, 24, 26, 0.28);
    border-right: 1px solid rgba(22, 24, 26, 0.28);
  }

  .old {
    top: 3px;
    height: var(--lane-h);
  }

  .new {
    top: calc(3px + var(--lane-h) + 3px);
    height: var(--lane-h);
  }

  /* Where the old survey left the country, in its last year. */
  .handover {
    position: absolute;
    top: 3px;
    height: var(--lane-h);
    width: 1px;
    background: rgba(22, 24, 26, 0.5);
  }

  /* The one mark that carries the latest figure. Position is the whole datum;
     the leaf and the handle are fixed pixels, so nothing about a door's own
     shape can be read as a quantity. */
  .door {
    position: absolute;
    top: 1px;
    height: calc(var(--row-h) - 3px);
    width: var(--door-w);
    transform: translateX(calc(var(--door-w) / -2));
    background: var(--door);
  }

  /* The step it stands on, drawn a little proud of the leaf on each side. */
  .door::before {
    content: '';
    position: absolute;
    left: -3px;
    right: -3px;
    bottom: -1px;
    height: 1px;
    background: var(--door);
  }

  .door::after {
    content: '';
    position: absolute;
    right: 1.6px;
    top: 50%;
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: var(--paper);
  }

  .key-field .old,
  .key-field .new,
  .key-field .handover {
    height: 14px;
  }

  .key-field .old,
  .key-field .handover {
    top: 4px;
  }

  .key-field .new {
    top: 24px;
  }

  .key-field .door {
    top: 1px;
    height: 40px;
    width: 12px;
    transform: translateX(-6px);
  }

  .key-field .door::after {
    right: 2.4px;
    width: 3px;
    height: 3px;
  }

  /* ---- The chart -------------------------------------------------------- */

  .plot {
    position: relative;
  }

  .head {
    position: relative;
    height: 40px;
    margin-left: var(--name-col);
    margin-right: var(--value-col);
  }

  /* A dimension line, drawn the way one is: a rule closed by two end ticks. */
  .gauge {
    position: absolute;
    bottom: 14px;
    left: 0;
    height: 7px;
    border-bottom: 1px solid rgba(22, 24, 26, 0.45);
    border-left: 1px solid rgba(22, 24, 26, 0.45);
    border-right: 1px solid rgba(22, 24, 26, 0.45);
  }

  .gauge-note {
    position: absolute;
    bottom: 4px;
    padding-left: 10px;
    font-size: 9.5px;
    letter-spacing: 0.06em;
    text-transform: none;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .gauge-note b {
    display: block;
    font-weight: 500;
    color: var(--ink);
  }

  .euro-note {
    position: absolute;
    bottom: 4px;
    /* The column is 0.7 years wide: the note has to start at it and run right. */
    transform: translateX(-2px);
    padding-left: 8px;
    border-left: 1px solid var(--rule);
    font-size: 9.5px;
    letter-spacing: 0.06em;
    line-height: 1.5;
    text-transform: none;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .euro-note b {
    display: block;
    font-weight: 500;
    color: var(--ink);
  }

  .body {
    position: relative;
  }

  .behind {
    position: absolute;
    left: var(--name-col);
    right: var(--value-col);
    top: 0;
    bottom: 0;
    pointer-events: none;
  }

  .rule {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--rule);
    opacity: 0.55;
  }

  .euro {
    position: absolute;
    top: 0;
    bottom: 0;
    background: rgba(22, 24, 26, 0.05);
    border-left: 1px dashed rgba(22, 24, 26, 0.34);
    border-right: 1px dashed rgba(22, 24, 26, 0.34);
  }

  .row {
    display: grid;
    grid-template-columns: var(--name-col) 1fr var(--value-col);
    align-items: center;
    height: var(--row-h);
  }

  .name {
    padding-right: 14px;
    font-size: 13px;
    line-height: 1.2;
    text-align: right;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .field {
    position: relative;
    height: var(--row-h);
  }

  /* The ground each door stands on, and the only rule between rows. */
  .field::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1px;
    height: 1px;
    background: rgba(22, 24, 26, 0.07);
  }

  .value {
    padding-left: 12px;
    font-size: 10.5px;
    letter-spacing: 0.04em;
    text-transform: none;
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }

  /* The country the piece is written from. Weight and a wash, never a hue:
     the one colour on this chart belongs to the doors. */
  .here {
    background: var(--accent-wash);
  }

  .here .name {
    font-weight: 500;
  }

  .here .value {
    color: var(--ink);
  }

  .axis {
    position: relative;
    height: 26px;
    margin-left: var(--name-col);
    margin-right: var(--value-col);
    border-top: 1px solid var(--rule);
  }

  .tick {
    position: absolute;
    top: 7px;
    transform: translateX(-50%);
    font-size: 10px;
    letter-spacing: 0.04em;
    text-transform: none;
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }

  /* ---- The numbers ------------------------------------------------------ */

  .numbers {
    margin-top: 26px;
  }

  .numbers summary {
    font-size: 10px;
    color: var(--ink-soft);
    cursor: pointer;
    list-style: none;
  }

  .numbers summary::-webkit-details-marker {
    display: none;
  }

  .numbers summary::before {
    content: '+ ';
  }

  .numbers[open] summary::before {
    content: '– ';
  }

  .numbers table {
    width: 100%;
    margin-top: 14px;
    border-collapse: collapse;
    font-size: 13px;
  }

  .numbers th {
    font-family: var(--mono);
    font-weight: 500;
    font-size: 9.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-align: left;
    color: var(--ink-soft);
    padding: 6px 10px 6px 0;
    border-bottom: 1px solid var(--rule);
  }

  .numbers td {
    padding: 5px 10px 5px 0;
    border-bottom: 1px solid var(--rule);
  }

  .numbers .num {
    font-size: 11.5px;
    letter-spacing: 0.02em;
    text-transform: none;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 860px) {
    .doorways {
      --name-col: 92px;
      --value-col: 38px;
    }
    .name {
      font-size: 11.5px;
      padding-right: 10px;
    }
    .euro-note,
    .gauge-note {
      white-space: normal;
      max-width: 26ch;
    }
    /* No room to set callouts clear of the marks: name the parts instead. */
    .key-plot,
    .only-wide {
      display: none;
    }
    .legend {
      display: block;
    }
    .kicker {
      margin-bottom: 14px;
    }
    .caveat {
      margin-top: 18px;
    }
  }
</style>
